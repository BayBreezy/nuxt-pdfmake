{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortTailwindcss": {
    "attributes": [":class", "class: "],
    "functions": ["tw", "tv"]
  },
  "ignorePatterns": [
    "dist/**",
    ".nuxt/**",
    "node_modules/**",
    "playground/.nuxt/**",
    "playground/node_modules/**",
    "docs/.nuxt/**",
    "docs/node_modules/**",
    "**/*.md",
    "**/*.mdc"
  ]
}
