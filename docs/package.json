{
  "name": "nuxt-pdfmake-docs",
  "private": true,
  "keywords": [
    "nuxt",
    "pdfmake"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=7120 nuxt build",
    "clean": "rm -rf .data .nuxt .output node_modules dist bun.lock && bun i && bun pm trust --all",
    "dev": "nuxt dev --host",
    "format": "oxfmt",
    "generate": "nuxt generate",
    "nuxt:prepare": "nuxt prepare",
    "prepare": "nuxt prepare",
    "preview": "nuxt preview"
  },
  "dependencies": {
    "@baybreezy/docd": "^0.0.9",
    "@faker-js/faker": "^10.4.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "nuxt": "^4.4.2",
    "nuxt-pdfmake": "^0.1.1",
    "vue": "^3.5.33",
    "vue-router": "5.0.6"
  },
  "trustedDependencies": [
    "@morev/vue-transitions",
    "@parcel/watcher",
    "better-sqlite3",
    "esbuild",
    "sharp",
    "vue-demi"
  ]
}
